@article{hadjimitsisDeterminationTurbidityKourris2006,
	title = {Determination of {{Turbidity}} in {{Kourris Dam}} in {{Cyprus Utilizing Landsat TM Remotely Sensed Data}}},
	author = {Hadjimitsis, Diofantos G. and Hadjimitsis, Marinos G. and Clayton, Chris and Clarke, Brian A.},
